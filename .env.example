# =============================================================
# National Public Grievance Portal — Environment Variables
# =============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit .env — it's already in .gitignore
# =============================================================

# ── Node.js Server ────────────────────────────────────────────
NODE_ENV=development          # Set to 'production' on Render
PORT=3000                     # Express listen port

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allowed origins. In dev, leave empty (open CORS).
# In production on Render, set to your Vercel domain:
#   CORS_ORIGIN=https://grievance-portal.vercel.app
CORS_ORIGIN=

# ── AI Microservice ───────────────────────────────────────────
# Option 1 (Recommended for production): Full URL of FastAPI service
#   Use this when FastAPI and Express are on DIFFERENT servers.
#   Leave empty when both run in the SAME container (Render single-service).
# AI_SERVICE_URL=https://my-ai-engine.onrender.com

# Option 2 (Local/legacy): Host + Port (used if AI_SERVICE_URL is not set)
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000

# ── Data Paths ────────────────────────────────────────────────
# These default to ./data_store and ./saved_models in config.py.
# Override only if using external storage mounts.
# DATA_DIR=/app/data_store
# MODELS_DIR=/app/saved_models
